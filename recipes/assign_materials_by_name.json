        "parms": {
            "exportlist": "*",
            "primpattern": "/geo/*",
            "snippet": "string name = usd_name(0, s@primpath);\nstring mats = \"/materials/\" + name;\n\nusd_addrelationshiptarget(0, s@primpath, \"material:binding\", mats);\nusd_setattrib(0, s@primpath, \"familyName\", \"materialBind\");"
