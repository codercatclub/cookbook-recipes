        ],
        "parms": {
            "breatheAmt": 0.01,
            "curveremap": [
                {
                    "interp": "linear",
                    "pos": 0,
                    "value": 1
                },
                {
                    "interp": "linear",
                    "pos": 1,
                    "value": 0.20000000298023224
                }
            ],
            "group": "edges",
            "moveAmt": 0.054,
            "snippet": "//add noise offset to all points \nint nearpt = nearpoint(1, @P);\n\nfloat rawCurve = clamp(point(1, \"curvature\", nearpt), 0.0, 1.0);\nfloat moveAmt = chramp(\"curveremap\", rawCurve);\n\nmoveAmt *= 1.0 + sin(-3 *v@P.y + 3 * rawCurve + 0.1 * @Frame);\n\nint n[] = neighbours(0, @ptnum);\nvector n1 = point(0,\"P\", n[0]);\nvector n2 = point(0,\"P\", n[1]);\n\nvector dir = (n1 + n2)/2.0 - @P;\n\nv@PNext = v@P+ 1.3 * chf(\"breatheAmt\") * moveAmt * @N;\nv@PNext += chf(\"moveAmt\") * moveAmt * curlnoise(@P + 0.01 * @Frame);\n\n"
        },
