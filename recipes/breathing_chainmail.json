            }
        ],
        "parms": {
            "class": "primitive",
            "curveremap": [
                {
                    "interp": "linear",
                    "pos": 0,
                    "value": 1
                },
                {
                    "interp": "linear",
                    "pos": 0.08798882365226746,
                    "value": 0.03333333507180214
                },
                {
                    "interp": "linear",
                    "pos": 0.9746299982070923,
                    "value": 0
                }
            ],
            "group": "!divided",
            "moveAmt": 0.015,
            "snippet": "//find all center points\nvector centerPos = @P;\nint centerpoints[] = nearpoints(0, \"divided\", centerPos, 0.01);\n\nvector combinedMoveAmt; \nvector avgpos;\n//printf(\"%s\", len(centerpoints));\nfor(int i = 0; i \u003c len(centerpoints); i++){\n    int num = centerpoints[i];\n    int n[] = neighbours(0, num);\n    vector n1 = point(0,\"PNext\", n[0]);\n    vector n2 = point(0,\"PNext\", n[1]);\n    float len2 = (@P - n2);\n    float len1 = (@P - n1);\n    float moveAmt1 = 0.52 * max(0.0,len1 - 0.07);\n    float moveAmt2 = 0.52 * max(0.0,len2 - 0.07);\n\n    \n    combinedMoveAmt += moveAmt1 * normalize(n1 - @P);\n    combinedMoveAmt += moveAmt2 * normalize(n2 - @P);\n    avgpos += n1;\n    \n    \n}\n\nfloat count = len(centerpoints);\ncombinedMoveAmt /= count;\navgpos /= count;\n\nfloat moveAmt = length(avgpos - @P);\nfor(int i = 0; i \u003c len(centerpoints); i++){\n    int num = centerpoints[i];\n    int n[] = neighbours(0, num);\n    vector n3 = point(0,\"PNext\", n[0]);\n    vector n2 = point(0,\"PNext\", n[1]);\n    \n    \n    \n    vector n1 = point(0,\"P\", num);\n    vector normz = point(0,\"N\", n[1]);\n    n1 = avgpos + combinedMoveAmt;\n    n1 += moveAmt * normz;\n    n1 += 8 * moveAmt * ((n2 + n3)/2.0 - n1);\n    setpointattrib(0, \"P\", num, n1);\n\n}\n\n\n"
        },
