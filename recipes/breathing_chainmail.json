    "create_prims": {
        "inputs": [
            {
                "from": "divide1",
                "from_index": 0,
                "to_index": 0
            }
        ],
        "parms": {
            "class": "primitive",
            "snippet": "//iterate over every primitive in our hexagonal mesh\nvector centerPos = @P;\naddpoint(0, @P);\n\nint primpts[] = primpoints(0, @primnum);\n\nfor(int i = 0; i \u003c len(primpts); i++){\n    //draw a line from pt to center and \n    //make it a prim \n    int new = addprim(0, \"poly\");\n    int center = addpoint(0, @P);\n    addvertex(0, new, primpts[i-1]);\n    addvertex(0, new, primpts[i]);\n    addvertex(0, new, center);\n    setprimgroup(0, \"divided\", new, 1);\n    setpointattrib(0, \"center\", center , 1, \"set\");\n    setprimattrib(0, \"curvature\",  new, @curvature, \"set\");\n    setpointgroup(0, \"divided\", center, 1);\n    setpointgroup(0, \"edges\", primpts[i-1],1);\n    setpointgroup(0, \"edges\", primpts[i],1);\n}\n\n\n\n\n\n\n"
        },
        "position": [
            0,
            1.08
        ],
        "type": "attribwrangle"
    },
