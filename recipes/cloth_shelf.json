                "to_index": 0
            }
        ],
        "parms": {
            "jitter": 0.012,
            "max_angle": 10.1,
            "max_num": 10,
            "min_angle": -10.1,
            "min_num": 3,
            "nseed": 19,
            "snippet": "int n = floor(fit01(rand(@ptnum + chi(\"nseed\")), chi(\"min_num\"), chi(\"max_num\")));\n\nfor(int i = 1; i \u003c n; i++) {\n    int id = i+@ptnum;\n    \n    float rx = fit01(rand(id)/2, -1, 1) * ch(\"jitter\");\n    float rz = fit01(rand(id+123), -1, 1) * ch(\"jitter\");\n    int pt = addpoint(0, set(@P.x + rx, @P.y + i*ch(\"y_offset\"), @P.z + rz));\n    \n    float angle90 = floor(fit01(rand(id), 0, 4)) * 90;\n    float angle = angle90 + fit01(rand(id), ch(\"min_angle\"), ch(\"max_angle\"));\n    vector axis = {0, 1, 0};\n    \n    vector4 orient = quaternion(radians(angle), axis);\n    \n    setpointattrib(0, \"orient\", pt, orient);\n}",
            "y_offset": 0.028
        },
        "parmtemplates": [
            {
