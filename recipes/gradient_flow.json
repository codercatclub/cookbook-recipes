    "compute_gradient": {
        "inputs": [
            {
                "from": "foreach_begin1",
                "from_index": 0,
                "to_index": 0
            }
        ],
        "parms": {
            "snippet": "int neibours[] = i[]@neibours;\n\nfloat accum = 0;\nfloat infect = 0;\n\nforeach (int pnt; neibours) {\n    infect = point(0, \"infect\", pnt);\n    if (infect \u003e 0) {\n        accum += 0.1;\n    }\n}\n\n@infect += accum / len(neibours);\n"
        },
        "position": [
            0,
            4.2
        ],
        "type": "attribwrangle"
    },
