    "gyroid": {
        "inputs": [
            {
                "from": "vdbfrompolygons1",
                "from_index": 0,
                "to_index": 0
            }
        ],
        "parms": {
            "freq": 9.3,
            "heightMul": 200,
            "snippet": "float freq = chf(\"freq\");\n\nfloat r = length(v@P);\nfloat theta = acos(@P.z/r);\nfloat phi = atan2(@P.y,@P.x);\n\nfloat x = freq * r;\nfloat y = freq * theta;\nfloat z = freq * phi;\n\nfloat fx = sin(x) * cos(y) + sin(y) * cos(z) + sin(z) * cos(x);\n\nif(fx \u003c 0.01){\n    @density = 0.0;\n} ",
            "totalCols": {
                "expression": "ch(\"../circle1/divs\")"
            }
        },
