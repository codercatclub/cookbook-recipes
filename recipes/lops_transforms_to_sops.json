    "strip_trailing_digits2": {
        "inputs": [
            {
                "from": "get_transform_from_usd",
                "from_index": 0,
                "to_index": 0
            }
        ],
        "parms": {
            "snippet": "// Strip trailing numbers and underscore+numbers from name attribute\n// e.g. \"apple2\" -\u003e \"apple\", \"anemone2_001\" -\u003e \"anemone\", \"apple3_004\" -\u003e \"apple\"\nstring original_name = s@name;\nstring cleaned_name = original_name;\n\n// First, strip underscore followed by digits (e.g. \"_001\", \"_004\")\nint underscore_pos = -1;\nint len = len(cleaned_name);\n\n// Find the last underscore followed only by digits\nfor (int i = len - 1; i \u003e= 0; i--) {\n    if (cleaned_name[i] == \"_\") {\n        // Check if everything after this underscore is digits\n        int all_digits = 1;\n        for (int j = i + 1; j \u003c len; j++) {\n            if (!isdigit(cleaned_name[j])) {\n                all_digits = 0;\n                break;\n            }\n        }\n        if (all_digits \u0026\u0026 i + 1 \u003c len) { // Make sure there's at least one digit after underscore\n            underscore_pos = i;\n            break;\n        }\n    }\n}\n\n// Strip the underscore and trailing digits if found\nif (underscore_pos \u003e= 0) {\n    cleaned_name = cleaned_name[0:underscore_pos];\n}\n\n// Now strip any remaining trailing digits from the base name\nlen = len(cleaned_name);\nint last_alpha = len - 1;\n\nfor (int i = len - 1; i \u003e= 0; i--) {\n    string char = cleaned_name[i];\n    if (!isdigit(char)) {\n        last_alpha = i;\n        break;\n    }\n}\n\n// Extract substring up to the last non-digit character\nif (last_alpha \u003e= 0) {\n    cleaned_name = cleaned_name[0:last_alpha + 1];\n} else {\n    // If the entire string is digits, keep it as is\n    cleaned_name = original_name;\n}\n\n// Set the cleaned name back to the name attribute\ns@name = cleaned_name;"
        },
        "position": [
            4.74,
            -2.8
        ],
        "type": "attribwrangle"
    },
