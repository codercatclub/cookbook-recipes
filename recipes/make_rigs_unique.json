    "__cookbookMeta": {
        "context": "sop",
        "version": "21.0.729",
        "systemfields": {
            "description": "Let say you have a skeleton and a skinned shape that you want to duplicate bunch of times and then control it as a single rig for example insect leg. This setup take packed duplicated kinefx rigs and make it unique by renaming bones according to packed rig names. See title image for clarification.",
            "category": "rigging",
            "image": "9c8d73465aae.jpg",
            "id": "9c8d73465aae",
            "date-created": "2026-07-16T10:05:16.16121986Z",
            "date-modified": "2026-07-16T10:05:16.161220276Z",
            "username": "kif",
            "tags": [
                "kinefx",
                "rig",
                "duplicate",
                "skeleton",
                "unique",
                "rename"
            ]
        }
    },
