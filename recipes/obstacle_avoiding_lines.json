                "from_index": 0,
                "to_index": 2
            }
        ],
        "parms": {
            "noise_amount": 0.273,
            "noise_freq": 2,
            "num_steps": 92,
            "snippet": "int primnum = addprim(0, \"polyline\");\naddvertex(0, primnum, @ptnum);\nint iteration = detail(2, \"iteration\", 0);\n\nvector curPos = v@P;\n\nfor(int i = 0; i\u003cchi(\"num_steps\"); i++){\n    int prim;\n    vector uv; \n    \n    float d = xyzdist(1, curPos, prim, uv);\n    \n    vector gradient = normalize(primuv(1, \"gradient\", prim, uv));\n    gradient += chf(\"noise_amount\")*curlnoise(chf(\"noise_freq\")*curPos + chf(\"strand_noise_amount\")*iteration);\n    \n    vector nextPos = curPos + chf(\"step_size\")*normalize(gradient);\n    \n    d = xyzdist(1, nextPos, prim, uv);\n    curPos = primuv(1, \"P\", prim, uv);\n\n    int point2 = addpoint(0, curPos);\n    addvertex(0, primnum, point2);\n}",
            "step_size": 0.026,
            "strand_noise_amount": 0.079
        },
