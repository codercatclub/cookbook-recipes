        ],
        "parms": {
            "class": "primitive",
            "head_length": 1,
            "snippet": "int pts[] = primpoints(0, @primnum);\n\nfor (int i = 0; i \u003c chi(\"head_length\"); i++) {\n    setpointgroup(0, \"first\", i, 1);\n}\n\nfor (int i = 0; i \u003c chi(\"tail_length\"); i++) {\n    setpointgroup(0, \"last\", len(pts)-1-i, 1);\n}\n\n\n\n\n",
            "tail_length": 1
        },
