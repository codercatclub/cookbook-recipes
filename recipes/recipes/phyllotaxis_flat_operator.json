    "create_phyllotaxis_points": {
        "flags": {
            "display": true,
            "render": true
        },
        "inputs": [
            {
                "from": "add1",
                "from_index": 0,
                "to_index": 0
            }
        ],
        "parms": {
            "angle": 137.5,
            "class": "detail",
            "numPoints": 730,
            "snippet": "int numPts = chi(\"numPoints\");\nfloat phi = chf('angle');           \n\nfor ( int i = 0; i \u003c numPts; i ++ ){\n    float r = 1.0/pow(numPts-1, 0.5);  \n    vector pos;\n    vector4 orient;\n\n    pos.x = r * sqrt(i) * cos(radians(phi)*i);\n    pos.z = r * sqrt(i) * sin(radians(phi)*i);\n\n    orient = quaternion(radians(phi*@ptnum), set(0,0,1)); \n    \n    addpoint(0, pos);\n    setpointattrib(0, \"orient\", i, orient);\n}"
        },
