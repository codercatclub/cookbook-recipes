        ],
        "parms": {
            "noise_by_edge": [
                {
                    "interp": "linear",
                    "pos": 0,
                    "value": 0
                },
                {
                    "interp": "linear",
                    "pos": 1,
                    "value": 1
                }
            ],
            "noise_by_height": [
                {
                    "interp": "linear",
                    "pos": 0,
                    "value": 0
                },
                {
                    "interp": "linear",
                    "pos": 1,
                    "value": 1
                }
            ],
            "snippet": "f@heightNoiseMask = chramp(\"noise_by_height\", -v@P.z);\nf@edgeNoiseMask = f@edge * chramp(\"noise_by_edge\", -v@P.z);\n\nv@P2 = normalize(v@P);"
