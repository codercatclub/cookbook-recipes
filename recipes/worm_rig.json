    "set_center_offset": {
        "color": [
            1,
            0.93,
            0
        ],
        "flags": {
            "colordefault": false
        },
        "inputs": [
            {
                "from": "clean1",
                "from_index": 0,
                "to_index": 0
            }
        ],
        "parms": {
            "distThreshold": 1,
            "falloffRate": 1,
            "maxHeight": 1,
            "snippet": "// Get indices of our two control points\nint h = 0;\nint t = 1;\n\n// Get positions of both points\nvector Ph = point(0, \"P\", h);\nvector Pt = point(0, \"P\", t);\n\n// Calculate the distance between points\nfloat dist = distance(Ph, Pt);\n\n// Calculate center point (middle of the two points)\nfloat center = (Ph.x + Pt.x) * 0.5;\n\n// User parameters\nfloat maxHeight = chf(\"maxHeight\");\nfloat falloffRate = chf(\"falloffRate\");\nfloat distThreshold = chf(\"distThreshold\");\n\n// Calculate height with threshold and falloff rate\n// Only start calculating height when distance is less than threshold\nfloat height;\nif (dist \u003e= distThreshold) {\n    height = 0;\n} else {\n    // Remap the distance to create a smooth transition\n    // When dist = distThreshold, height = 0\n    // When dist = 0, height approaches maxHeight\n    float adjustedDist = fit(dist, 0, distThreshold, 0, 1);\n    // Use falloffRate as an exponent to control the curve shape\n    height = maxHeight * pow(1 - adjustedDist, falloffRate);\n}\n\n// Ensure height never goes below zero\nheight = max(height, 0);\n\n// Store values as detail attributes\nsetdetailattrib(0, \"center\", center, \"set\");\nsetdetailattrib(0, \"height\", height, \"set\");"
        },
        "parmtemplates": [
            {
                "insert_after": "vex_threadjobsize",
                "parmtemplates": {
                    "folder_generatedparms_snippet": {
                        "label": "Generated Channel Parameters",
                        "parmtemplates": {
                            "distThreshold": {
                                "label": "Distthreshold",
                                "max_value": 1,
                                "script_callback_language": "hscript",
                                "type": "float"
                            },
                            "falloffRate": {
                                "label": "Falloffrate",
                                "max_value": 1,
                                "script_callback_language": "hscript",
                                "type": "float"
                            },
                            "maxHeight": {
                                "label": "Maxheight",
                                "max_value": 1,
                                "script_callback_language": "hscript",
                                "type": "float"
                            }
                        },
                        "script_callback_language": "hscript",
                        "tags": {
                            "group_type": "simple",
                            "sidefx::look": "blank"
                        },
                        "type": "folder_simple"
                    }
                }
            }
        ],
